@page "/"
@inject IJSRuntime JS

<PageTitle>.NET Date and Time Tester</PageTitle>

<main id="main-content" class="tool" aria-labelledby="lab-heading">
    <section class="tool-controls" aria-label="Date and time tester">
        <div class="preset-bar">
            <div class="preset-picker">
                <label for="preset">Try an example</label>
                <select id="preset" name="preset" value="@selectedPreset" @onchange="SelectPreset">
                    <option value="" disabled>Custom settings</option>
                    @foreach (var preset in Presets)
                    {
                        <option value="@preset.Id">@preset.Label</option>
                    }
                </select>
            </div>
            <button type="button" class="secondary" @onclick="Reset">Reset</button>
        </div>

        <form class="tool-form" method="get" action="/" aria-labelledby="interpret-heading" @onsubmit="Analyze" @onsubmit:preventDefault @onkeydown="HandleShortcut">
            <h2 id="interpret-heading">Parse a date or time</h2>

            <div class="field field-wide">
                    <label for="input-value">Date or time value</label>
                    <p id="input-value-hint" class="hint">Enter the same text your application receives. Parsing runs only in this browser.</p>
                    <input id="input-value" name="value" value="@input" @oninput="UpdateInput"
                           required autocapitalize="none" autocorrect="off" spellcheck="false"
                           aria-describedby="@(showError ? "input-value-hint input-value-error" : "input-value-hint")"
                           aria-invalid="@(showError ? "true" : "false")" />
                    @if (showError)
                    {
                        <p id="input-value-error" class="field-error">@result.Error</p>
                    }
            </div>

            <fieldset class="type-options">
                    <legend>.NET type</legend>
                    @foreach (var type in Enum.GetValues<LabValueType>())
                    {
                        var id = $"type-{type.ToString().ToLowerInvariant()}";
                        <span class="radio-option">
                            <input id="@id" type="radio" name="value-type" value="@type" checked="@(valueType == type)" @onchange="() => ChangeType(type)" />
                            <label for="@id">@type</label>
                        </span>
                    }
            </fieldset>

            <details class="options">
                <summary>Parsing options</summary>
                <div class="options-body">
                    <div class="field-grid">
                        <div class="field">
                            <label for="culture">Culture</label>
                            <select id="culture" name="culture" @bind="cultureName">
                                @foreach (var culture in Cultures)
                                {
                                    <option value="@culture.Id">@culture.Label</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label for="styles">DateTimeStyles</label>
                            <select id="styles" name="styles" @bind="stylesKey">
                                @foreach (var style in StylePresets)
                                {
                                    <option value="@style.Id">@style.Label</option>
                                }
                            </select>
                        </div>
                        <div class="field field-wide">
                            <label for="exact-format">Exact format <span class="optional">optional</span></label>
                            <p id="exact-format-hint" class="hint">Leave blank for <code>Parse</code>; add a pattern for <code>ParseExact</code>.</p>
                            <input id="exact-format" name="format" @bind="exactFormat" aria-describedby="exact-format-hint"
                                   autocapitalize="none" autocorrect="off" spellcheck="false" />
                        </div>
                    </div>
                    <fieldset class="zone-fields" disabled="@(valueType is LabValueType.DateOnly or LabValueType.TimeOnly)">
                        <legend>Time-zone interpretation</legend>
                        <div class="field-grid">
                            <div class="field">
                                <label for="source-zone">Source time zone</label>
                                <select id="source-zone" name="source-zone" @bind="sourceZoneId">
                                    @foreach (var zone in Zones) { <option value="@zone.Id">@zone.Label</option> }
                                </select>
                            </div>
                            <div class="field">
                                <label for="target-zone">Convert to time zone</label>
                                <select id="target-zone" name="target-zone" @bind="targetZoneId">
                                    @foreach (var zone in Zones) { <option value="@zone.Id">@zone.Label</option> }
                                </select>
                            </div>
                        </div>
                    </fieldset>
                    <p class="docs-links inline-docs"><a href="https://learn.microsoft.com/dotnet/api/system.datetime.parse" target="_blank" rel="noopener">Parse API</a> · <a href="https://learn.microsoft.com/dotnet/standard/base-types/custom-date-and-time-format-strings" target="_blank" rel="noopener">Format strings</a> · <a href="https://learn.microsoft.com/dotnet/api/system.globalization.datetimestyles" target="_blank" rel="noopener">DateTimeStyles</a></p>
                </div>
            </details>

            <div class="primary-actions">
                <button id="analyze-button" type="submit" class="primary">Analyze with .NET</button>
                <span class="shortcut-hint"><kbd>Ctrl</kbd>/<kbd>⌘</kbd> + <kbd>Enter</kbd></span>
            </div>

            <div class="session-tools" aria-label="Session tools">
                <button type="button" class="secondary" @onclick="CopyShareLink">Copy link</button>
                <span class="remember-option"><input id="remember-state" type="checkbox" checked="@rememberOnDevice" @onchange="ToggleRemember" /><label for="remember-state">Remember on this device</label></span>
                <button type="button" class="text-button" @onclick="ForgetSavedWork" disabled="@(!rememberOnDevice)">Forget saved work</button>
            </div>
            <p class="privacy-note">Remembering is optional and stores the current value in this browser. Shared links put state after <code>#</code>, so it is not sent to the web server.</p>
        </form>
    </section>

    <section class="results-panel" aria-labelledby="inspect-heading">
            <h2 id="inspect-heading">Result</h2>

            <div id="result-status" class="result-status @(result.Success ? "success" : showError ? "error" : "idle")" role="status" aria-live="polite">
                @if (result.Success)
                {
                    <strong>@result.Summary</strong>
                    <span>@result.SemanticKind</span>
                }
                else if (showError)
                {
                    <strong>Parsing failed.</strong>
                    <span>@result.Error</span>
                }
                else
                {
                    <strong>Ready to inspect.</strong>
                    <span>Choose an example or enter a value, then analyze it.</span>
                }
            </div>

            @if (result.Success)
            {
                <section class="parse-explanation" aria-labelledby="parse-explanation-heading">
                    <div>
                        <h3 id="parse-explanation-heading">Why parsing succeeded</h3>
                        <p><code>@result.ParseMethod</code> · @result.ParseExplanation</p>
                    </div>
                    <a href="https://learn.microsoft.com/dotnet/standard/base-types/parsing-datetime" target="_blank" rel="noopener">Parsing documentation</a>
                </section>

                @if (result.IsInvalidTime)
                {
                    <aside class="callout danger" aria-labelledby="dst-invalid-heading">
                        <h3 id="dst-invalid-heading">This wall time does not exist</h3>
                        <p>The clock jumps over this value during the daylight-saving transition in the selected source zone. It cannot identify an instant without a correction policy.</p>
                    </aside>
                }
                else if (result.IsAmbiguousTime)
                {
                    <aside class="callout warning" aria-labelledby="dst-ambiguous-heading">
                        <h3 id="dst-ambiguous-heading">This wall time occurs twice</h3>
                        <p>The clock repeats this value when daylight saving ends. Choose a policy or retain the offset so the intended instant remains unambiguous.</p>
                        <div class="table-scroll" tabindex="0" role="region" aria-label="Possible UTC instants">
                            <table>
                                <caption>Possible UTC instants for this wall time</caption>
                                <thead><tr><th scope="col">Interpretation</th><th scope="col">UTC result</th><th scope="col">Detail</th></tr></thead>
                                <tbody>
                                    @foreach (var item in result.AmbiguousInstants)
                                    {
                                        <tr><th scope="row">@item.Label</th><td><code>@item.Value</code></td><td>@item.Note</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </aside>
                }

                <section class="result-section" aria-labelledby="value-details-heading">
                    <h3 id="value-details-heading">Value details</h3>
                    <dl class="inspection-list">
                        @foreach (var item in result.Inspection)
                        {
                            <div>
                                <dt>@item.Label</dt>
                                <dd><code>@item.Value</code>@if (!string.IsNullOrEmpty(item.Note)) { <small>@item.Note</small> }</dd>
                            </div>
                        }
                    </dl>
                </section>

                <section class="result-section" aria-labelledby="conversions-heading">
                    <h3 id="conversions-heading">Conversions</h3>
                    <div class="table-scroll" tabindex="0" role="region" aria-label="Equivalent date and time representations">
                        <table>
                            <caption>Equivalent representations produced by .NET</caption>
                            <thead><tr><th scope="col">Representation</th><th scope="col">Value</th><th scope="col">Note</th></tr></thead>
                            <tbody>
                                @foreach (var item in result.Conversions)
                                {
                                    <tr><th scope="row">@item.Label</th><td><code>@item.Value</code></td><td>@item.Note</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <div class="result-actions">
                    <button type="button" class="secondary" @onclick="CopyResult">Copy result</button>
                    <button type="button" class="secondary" @onclick="CopyCode">@copyState</button>
                </div>
            }
    </section>

    <details class="reference code-panel">
        <summary id="reproduce-heading">C# for this result</summary>
        <div class="disclosure-body">
            <pre tabindex="0"><code>@result.GeneratedCode</code></pre>
        </div>
    </details>

    <details class="reference">
        <summary id="reference-heading">Date and time type reference</summary>
        <div class="disclosure-body table-scroll" tabindex="0" role="region" aria-label="Date and time type reference">
            <table>
                <caption>What each .NET date and time type preserves</caption>
                <thead><tr><th scope="col">Type</th><th scope="col">Date</th><th scope="col">Time</th><th scope="col">Offset</th><th scope="col">Unambiguous instant</th></tr></thead>
                <tbody>
                    <tr><th scope="row"><code>DateTimeOffset</code></th><td>Yes</td><td>Yes</td><td>Yes</td><td>Yes</td></tr>
                    <tr><th scope="row"><code>DateTime</code></th><td>Yes</td><td>Yes</td><td>Kind only</td><td>Only when UTC or externally interpreted</td></tr>
                    <tr><th scope="row"><code>DateOnly</code></th><td>Yes</td><td>No</td><td>No</td><td>No</td></tr>
                    <tr><th scope="row"><code>TimeOnly</code></th><td>No</td><td>Yes</td><td>No</td><td>No</td></tr>
                </tbody>
            </table>
            <p class="docs-links"><a href="https://learn.microsoft.com/dotnet/standard/datetime/choosing-between-datetime">Choose a .NET date/time type</a> · <a href="https://learn.microsoft.com/dotnet/standard/datetime/time-zone-overview">Time-zone behavior</a> · <a href="https://learn.microsoft.com/dotnet/standard/base-types/parsing-datetime">Parsing documentation</a></p>
        </div>
    </details>
</main>

<p id="action-status" class="action-status" role="status" aria-live="polite">@actionStatus</p>

@code {
    private static readonly Choice[] Cultures =
    [
        new("", "Invariant culture"), new("en-US", "en-US · English (United States)"),
        new("en-GB", "en-GB · English (United Kingdom)"), new("nl-BE", "nl-BE · Dutch (Belgium)"),
        new("fr-FR", "fr-FR · French (France)"), new("de-DE", "de-DE · German (Germany)"),
        new("ja-JP", "ja-JP · Japanese (Japan)")
    ];
    private static readonly Choice[] Zones =
    [
        new("UTC", "UTC"), new("__local", "Browser local time zone"),
        new("America/New_York", "America/New_York"), new("America/Chicago", "America/Chicago"),
        new("America/Denver", "America/Denver"), new("America/Los_Angeles", "America/Los_Angeles"),
        new("Europe/Brussels", "Europe/Brussels"), new("Europe/London", "Europe/London"),
        new("Asia/Kolkata", "Asia/Kolkata"), new("Asia/Tokyo", "Asia/Tokyo"),
        new("Australia/Sydney", "Australia/Sydney")
    ];
    private static readonly StyleChoice[] StylePresets =
    [
        new("None", "None", DateTimeStyles.None), new("AllowWhiteSpaces", "Allow white space", DateTimeStyles.AllowWhiteSpaces),
        new("AssumeLocal", "Assume local", DateTimeStyles.AssumeLocal), new("AssumeUniversal", "Assume universal", DateTimeStyles.AssumeUniversal),
        new("AssumeUniversalAdjust", "Assume universal + adjust to UTC", DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal),
        new("AdjustToUniversal", "Adjust to UTC", DateTimeStyles.AdjustToUniversal), new("RoundtripKind", "Round-trip kind", DateTimeStyles.RoundtripKind)
    ];
    private static readonly Preset[] Presets =
    [
        new("dst-overlap", "DST overlap · two possible instants", "2026-11-01 01:30", LabValueType.DateTime, "en-US", "yyyy-MM-dd HH:mm", "None", "America/New_York", "Europe/Brussels"),
        new("dst-gap", "DST gap · nonexistent wall time", "2026-03-08 02:30", LabValueType.DateTime, "en-US", "yyyy-MM-dd HH:mm", "None", "America/New_York", "UTC"),
        new("ambiguous-culture-us", "04/05 changes meaning · en-US", "04/05/2026 09:00", LabValueType.DateTime, "en-US", "", "None", "America/New_York", "UTC"),
        new("ambiguous-culture-gb", "04/05 changes meaning · en-GB", "04/05/2026 09:00", LabValueType.DateTime, "en-GB", "", "None", "Europe/London", "UTC"),
        new("assume-universal", "No offset · AssumeUniversal changes Kind", "2026-11-26 14:30", LabValueType.DateTime, "", "yyyy-MM-dd HH:mm", "AssumeUniversalAdjust", "UTC", "America/New_York"),
        new("offset", "Offset timestamp · one instant", "2026-11-26T14:30:00-05:00", LabValueType.DateTimeOffset, "", "", "RoundtripKind", "America/New_York", "Europe/Brussels"),
        new("culture", "Culture-sensitive date", "31/12/2026 23:45", LabValueType.DateTime, "fr-FR", "", "None", "Europe/Brussels", "America/New_York"),
        new("date-only", "Birthday · DateOnly", "1988-06-12", LabValueType.DateOnly, "", "yyyy-MM-dd", "None", "UTC", "UTC"),
        new("time-only", "Opening time · TimeOnly", "09:30", LabValueType.TimeOnly, "", "HH:mm", "None", "UTC", "UTC")
    ];

    private string selectedPreset = Presets[0].Id;
    private string input = Presets[0].Input;
    private LabValueType valueType = Presets[0].Type;
    private string cultureName = Presets[0].Culture;
    private string exactFormat = Presets[0].Format;
    private string stylesKey = Presets[0].Styles;
    private string sourceZoneId = Presets[0].SourceZone;
    private string targetZoneId = Presets[0].TargetZone;
    private bool attempted;
    private ParseResult result = new() { GeneratedCode = "// Analyze a value to generate the equivalent C#." };
    private string copyState = "Copy C#";
    private string actionStatus = string.Empty;
    private bool rememberOnDevice;
    private int announcementSequence;
    private bool showError => attempted && !result.Success;

    protected override void OnInitialized() => RunAnalysis();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var initial = await JS.InvokeAsync<InitialState>("dateTimeLab.getInitialState");
            rememberOnDevice = initial.Remembered;
            if (!string.IsNullOrWhiteSpace(initial.State))
            {
                var state = System.Text.Json.JsonSerializer.Deserialize<SessionState>(initial.State);
                if (state is not null && ApplyState(state))
                {
                    attempted = true;
                    RunAnalysis();
                    Announce(initial.Source == "link" ? "Loaded settings from the shared link." : "Restored remembered work from this device.");
                }
                else
                {
                    Announce("The saved state was invalid, so the default example was used.");
                }
            }
        }
        catch (Exception exception) when (exception is JSException or System.Text.Json.JsonException)
        {
            Announce("The saved state could not be loaded, so the default example was used.");
        }
        StateHasChanged();
    }

    private async Task Analyze()
    {
        attempted = true;
        RunAnalysis();
        await SaveRememberedState();
    }

    private async Task HandleShortcut(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey)) await Analyze();
    }

    private void RunAnalysis()
    {
        var styles = StylePresets.First(style => style.Id == stylesKey).Styles;
        result = DateTimeLabEngine.Parse(new(input, valueType, cultureName, exactFormat, styles, sourceZoneId, targetZoneId));
        copyState = "Copy C#";
    }

    private void UpdateInput(ChangeEventArgs args)
    {
        input = args.Value?.ToString() ?? string.Empty;
        if (result.Success || showError) { attempted = false; result = new() { GeneratedCode = "// Analyze the updated value to generate C#." }; }
    }

    private void ChangeType(LabValueType type)
    {
        valueType = type; attempted = false; result = new() { GeneratedCode = "// Analyze the selected type to generate C#." };
    }

    private async Task SelectPreset(ChangeEventArgs args)
    {
        selectedPreset = args.Value?.ToString() ?? Presets[0].Id;
        ApplyPreset(Presets.First(item => item.Id == selectedPreset));
        await SaveRememberedState();
    }

    private async Task Reset()
    {
        selectedPreset = Presets[0].Id;
        ApplyPreset(Presets[0]);
        try { await JS.InvokeVoidAsync("dateTimeLab.clearShareState"); }
        catch (JSException) { }
        if (rememberOnDevice) await SaveRememberedState();
        Announce("Reset to the default DST overlap example.");
    }

    private void ApplyPreset(Preset preset)
    {
        input = preset.Input; valueType = preset.Type; cultureName = preset.Culture; exactFormat = preset.Format;
        stylesKey = preset.Styles; sourceZoneId = preset.SourceZone; targetZoneId = preset.TargetZone; attempted = true; RunAnalysis();
    }

    private async Task CopyCode()
    {
        try
        {
            var copied = await JS.InvokeAsync<bool>("dateTimeLab.copyText", result.GeneratedCode);
            copyState = copied ? "Copied" : "Copy failed";
            Announce(copied ? "Copied C#." : "Copy failed.");
        }
        catch (JSException)
        {
            copyState = "Copy failed";
            Announce("Copy failed.");
        }
    }

    private async Task CopyResult()
    {
        var lines = new List<string> { result.Summary, result.SemanticKind, $"Method: {result.ParseMethod}", result.ParseExplanation };
        lines.AddRange(result.Inspection.Select(item => $"{item.Label}: {item.Value}{(string.IsNullOrWhiteSpace(item.Note) ? "" : $" — {item.Note}")}"));
        lines.AddRange(result.Conversions.Select(item => $"{item.Label}: {item.Value}{(string.IsNullOrWhiteSpace(item.Note) ? "" : $" — {item.Note}")}"));
        try
        {
            var copied = await JS.InvokeAsync<bool>("dateTimeLab.copyText", string.Join(Environment.NewLine, lines));
            Announce(copied ? "Copied result." : "Copy result failed.");
        }
        catch (JSException) { Announce("Copy result failed."); }
    }

    private async Task CopyShareLink()
    {
        try
        {
            var status = await JS.InvokeAsync<string>("dateTimeLab.copyShareLink", SerializeState());
            Announce(status switch
            {
                "copied" => "Copied a private-by-default share link. Its state is stored after the URL hash.",
                "too-large" => "This state is too large to fit safely in a share link.",
                _ => "Copy link failed. Check clipboard permission and try again."
            });
        }
        catch (JSException) { Announce("Copy link failed. Check clipboard permission and try again."); }
    }

    private async Task ToggleRemember(ChangeEventArgs args)
    {
        rememberOnDevice = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        bool saved;
        try { saved = await JS.InvokeAsync<bool>("dateTimeLab.setRememberedState", rememberOnDevice, SerializeState()); }
        catch (JSException) { saved = false; }
        if (!saved) rememberOnDevice = false;
        Announce(saved
            ? rememberOnDevice ? "This browser will remember the last analyzed value." : "Remembering is off and saved work was removed."
            : "Browser storage is unavailable; remembering remains off.");
    }

    private async Task ForgetSavedWork()
    {
        bool forgotten;
        try { forgotten = await JS.InvokeAsync<bool>("dateTimeLab.forgetRememberedState"); }
        catch (JSException) { forgotten = false; }
        if (forgotten) rememberOnDevice = false;
        Announce(forgotten ? "Forgot saved work on this device." : "Saved work could not be removed.");
    }

    private async Task SaveRememberedState()
    {
        if (!rememberOnDevice) return;
        try { await JS.InvokeVoidAsync("dateTimeLab.saveRememberedState", SerializeState()); }
        catch (JSException) { Announce("The analyzed value could not be saved on this device."); }
    }

    private string SerializeState() => System.Text.Json.JsonSerializer.Serialize(new SessionState(
        1, input, valueType, cultureName, exactFormat, stylesKey, sourceZoneId, targetZoneId));

    private bool ApplyState(SessionState state)
    {
        if (state.Version != 1 || state.Input is null || state.Input.Length > 10_000 ||
            !Enum.IsDefined(state.ValueType) || !Cultures.Any(item => item.Id == state.Culture) ||
            !StylePresets.Any(item => item.Id == state.Styles) || !Zones.Any(item => item.Id == state.SourceZone) ||
            !Zones.Any(item => item.Id == state.TargetZone) || (state.Format?.Length ?? 0) > 500) return false;

        input = state.Input;
        valueType = state.ValueType;
        cultureName = state.Culture;
        exactFormat = state.Format ?? string.Empty;
        stylesKey = state.Styles;
        sourceZoneId = state.SourceZone;
        targetZoneId = state.TargetZone;
        selectedPreset = Presets.FirstOrDefault(preset => preset.Input == input && preset.Type == valueType)?.Id ?? string.Empty;
        return true;
    }

    private void Announce(string message)
    {
        announcementSequence++;
        actionStatus = announcementSequence % 2 == 0 ? message + "\u00A0" : message;
    }

    private sealed record Choice(string Id, string Label);
    private sealed record StyleChoice(string Id, string Label, DateTimeStyles Styles);
    private sealed record Preset(string Id, string Label, string Input, LabValueType Type, string Culture, string Format, string Styles, string SourceZone, string TargetZone);
    private sealed record SessionState(int Version, string Input, LabValueType ValueType, string Culture, string? Format, string Styles, string SourceZone, string TargetZone);
    private sealed class InitialState
    {
        public string? State { get; set; }
        public bool Remembered { get; set; }
        public string Source { get; set; } = "default";
    }
}
